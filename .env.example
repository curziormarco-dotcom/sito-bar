# Solo per configurare la GitHub App durante lo sviluppo locale.
# Lascia 0 per modificare soltanto i file locali.
NEXT_PUBLIC_CMS_GITHUB=0

# Generati dalla configurazione Keystatic / GitHub App.
# Copiarli nelle variabili del progetto Vercel; non inserirli nel repository.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
